# ============================================================
# Vachanamrut Quiz Platform v3.1 - MySQL production settings
# ============================================================

# Keep this value unchanged after deployment. If it changes, existing login
# cookies become invalid and users must sign in again.
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# MySQL connection used by the application.
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vachanamrut_quiz
MYSQL_USER=quiz_user
MYSQL_PASSWORD=change-this-mysql-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280

# Optional: use one DATABASE_URL instead of MYSQL_* variables above.
# DATABASE_URL=mysql+pymysql://quiz_user:password@127.0.0.1:3306/vachanamrut_quiz?charset=utf8mb4

# Only needed when scripts/create_mysql_database.py must create the DB/user.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Docker Compose database root password.
MYSQL_ROOT_PASSWORD=change-this-root-password

# Super Admin password-reset email
MAIL_DELIVERY_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vachanamrut Quiz
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Fixed single Super Admin identity (v3.2)
# Only this email is accepted by /super-admin-access.
SUPER_ADMIN_EMAIL=sadhusevakdas215@sgrs.org
SUPER_ADMIN_BOOTSTRAP_PASSWORD=@gurukulquiz2184
