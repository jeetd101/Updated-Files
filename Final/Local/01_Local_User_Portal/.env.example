# Server-side settings only. Copy this file to .env on the server.
# Never place .env inside a public/static/frontend folder.

APP_PORT=8041
PORTAL_MODE=local_user
TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# All 3 deployments must connect to the SAME MySQL database.
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vachanamrut_quiz
MYSQL_USER=quiz_user
MYSQL_PASSWORD=PUT_YOUR_PRIVATE_MYSQL_PASSWORD_HERE
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280

# APP_SECRET is intentionally omitted. The server generates a private signing
# secret automatically in data/.app_secret and never sends it to the browser.

MAIL_DELIVERY_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vachanamrut Quiz
SMTP_USE_TLS=true
SMTP_USE_SSL=false
